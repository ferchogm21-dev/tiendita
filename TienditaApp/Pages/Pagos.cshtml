@page
@model TienditaApp.Pages.PagosModel

<h1>💰 Pagos / Deudores</h1>

@if (TempData["Error"] != null)
{
    <div style="color:red; font-weight:bold; margin-bottom:10px;">
        @TempData["Error"]
    </div>
}

<h3>💰 Total que deben todos: $@Model.TotalGeneralDeuda</h3>
<hr />

<h2>Clientes con deuda</h2>
<style>
    body {
        background: #f5f7fa;
        font-family: Arial, sans-serif;
    }

    /* INPUTS */
    input {
        padding: 10px;
        margin: 8px 5px;
        border-radius: 8px;
        border: 1px solid #ccc;
    }

    /* TABLA (MISMO ESTILO QUE LA OTRA) */
    .table th {
    background: #ffc107;
    color: white;
    
}

    /* CELDAS */
    td {
        padding: 10px;
        text-align: center;
        border-bottom: 1px solid #eee;
        white-space: nowrap;
    }

    /* HOVER FILAS */
    tr:hover {
        background-color: #f1f1f1;
    }

    /* BOTONES */
    button {
        padding: 10px 18px;
        border: none;
        border-radius: 8px;
        background: #198754;
        color: white;
        cursor: pointer;
        transition: 0.3s;
    }

    button:hover {
        opacity: 0.9;
    }
</style>
<table class="table">
    <thead>
    <tr>
            <th>Cliente</th>
            <th>Total</th>
            <th>Pagado</th>
            <th>Debe</th>
            <th>Acciones</th>
        </tr>

    @foreach (var d in Model.DeudasCliente)
    {
        var telefono = !string.IsNullOrEmpty(d.Telefono)
        ? "521" + d.Telefono
        : "";

        var mensaje = Model.GenerarMensajeDetalle(d.ClienteId, d.ClienteNombre);

        var link = $"https://wa.me/{telefono}?text={mensaje}";
        <tr style="text-align:center;">
            <td>@d.ClienteNombre</td>
            <td>$@d.TotalDeuda</td>
            <td>$@d.TotalPagado</td>
            <td style="color:red;">$@d.Debe</td>
            <td>
                <a asp-page="Pagos"
                   asp-route-clienteId="@d.ClienteId"
                   class="btn btn-info">
                   👁️ Ver detalles
                </a>
                <a href="@link" target="_blank"
                class="btn btn-sm btn-success">
                    <i class="bi bi-whatsapp"></i> WhatsApp
                </a>
            </td>
        </tr>
    }
    <thead>
</table>

<hr />

<!-- 🔥 MODAL -->
<div class="modal fade show" id="modalDetalle"
     style="display:@(Model.ClienteIdActual != null ? "block" : "none"); background:rgba(0,0,0,0.5);">

    <div class="modal-dialog modal-lg" style="max-width: 950px;">
        <div class="modal-content">

            <div class="modal-header">
                <h5>Detalle de @Model.ClienteNombreActual</h5>
                <a asp-page="Pagos" class="btn-close"></a>
            </div>

            <div class="modal-body">

                @if (Model.ClienteIdActual != null)
                {
                    <table class="table">
                        <tr>
                            <th>Producto</th>
                            <th>Fecha</th>
                            <th>Total</th>
                            <th>Pagado</th>
                            <th>Debe</th>
                            <th>Acciones</th>
                        </tr>

                        @foreach (var v in Model.VentasCliente)
                        {
                            var debe = v.Total - (v.Pagado ?? 0);

                            <tr style="text-align:center;">
                                <td>@v.ProductoNombre</td>
                                <td>@v.Fecha.ToString("dd/MM/yyyy")</td>
                                <td>$@v.Total</td>
                                <td>$@v.Pagado</td>
                                <td style="color:red;">$@debe</td>

                                <td>
                                    @if (debe > 0)
                                    {
                                        <div style="display:flex; justify-content:center; align-items:center; gap:5px;">

                                            <!-- 💰 ABONAR -->
                                            <form method="post" asp-page-handler="AbonarVenta" onsubmit="return validarAbono(this)">
                                                <input type="hidden" name="ventaId" value="@v.Id" />
                                                <input type="hidden" name="clienteId" value="@Model.ClienteIdActual" />
                                                <input type="number" step="0.01" name="abono" placeholder="$" style="width:70px;" />
                                                <button style="background:#0d6efd;color:white;">Abonar 💰</button>
                                            </form>

                                            <!-- ✔ LIQUIDAR -->
                                            <form method="post" asp-page-handler="LiquidarVenta">
                                                <input type="hidden" name="ventaId" value="@v.Id" />
                                                <input type="hidden" name="clienteId" value="@Model.ClienteIdActual" />
                                                <button onclick="return confirm('¿Liquidar este producto?')"style="background:#198754;color:white;">Liquidar✔</button>
                                            </form>

                                        </div>
                                    }
                                    else
                                    {
                                        <!-- ↩ DESHACER -->
                                        <form method="post" asp-page-handler="DeshacerLiquidacion">
                                            <input type="hidden" name="ventaId" value="@v.Id" />
                                            <input type="hidden" name="clienteId" value="@Model.ClienteIdActual" />
                                            <button style="background:#dc3545;color:white;">
                                                ↩
                                            </button>
                                        </form>
                                    }
                                </td>
                            </tr>
                        }
                    </table>
                }
                <script>
                function validarAbono(form) {
                    var abono = form.abono.value;

                    if (!abono || parseFloat(abono) <= 0) {
                        alert("Ingresa un monto válido");
                        return false;
                    }

                    return true;
                }
                </script>

            </div>

        </div>
    </div>
</div>