@page
@model TienditaApp.Pages.PagosModel

<style>

body {
    background: #f5f7fa;
    font-family: Arial, sans-serif;
}

/* CARD */
.card {
    background: white;
    border-radius: 15px;
    box-shadow: 0 5px 20px rgba(0,0,0,0.08);
    padding: 20px;
    margin-bottom: 20px;
}

/* TABLAS */
.table {
    background: white;
    border-radius: 10px;
    overflow: hidden;
}

.table th {
    background: #ffc107;
    color: black;
    text-align: center;
    vertical-align: middle;
}

.table td {
    text-align: center;
    vertical-align: middle;
    white-space: nowrap;
}

/* HOVER */
.table tbody tr:hover {
    background: #f8f9fa;
}

/* INPUTS */
input {
    padding: 8px;
    border-radius: 8px;
    border: 1px solid #ccc;
}

/* BOTONES */
button {
    border: none;
    border-radius: 8px;
    padding: 6px 12px;
    transition: 0.2s;
}

button:hover {
    opacity: 0.9;
    transform: scale(1.02);
}

/* MODAL */
.modal-content {
    border-radius: 15px;
    border: none;
}

.modal-header {
    background: #ffc107;
    color: black;
}

/* DEUDA */
.deuda {
    color: red;
    font-weight: bold;
}

</style>

<h1>💰 Pagos / Deudores</h1>

@if (TempData["Error"] != null)
{
    <div style="color:red; font-weight:bold; margin-bottom:10px;">
        @TempData["Error"]
    </div>
}

<div class="card">

    <h3 class="mb-0">
        💰 Total que deben todos:
        <span class="text-danger">
            $@Model.TotalGeneralDeuda
        </span>
    </h3>

</div>
<hr />

<h2>Clientes con deuda</h2>

<div class="card">

<div class="table-responsive">

<table class="table table-hover align-middle">
    <thead>
    <tr>
            <th>Cliente</th>
            <th>Total</th>
            <th>Pagado</th>
            <th>Debe</th>
            <th>Acciones</th>
        </tr>

    @foreach (var d in Model.DeudasCliente)
    {
        var telefono = !string.IsNullOrEmpty(d.Telefono)
        ? "521" + d.Telefono
        : "";

        var mensaje = Model.GenerarMensajeDetalle(d.ClienteId, d.ClienteNombre);

        var link = $"https://wa.me/{telefono}?text={mensaje}";
        <tr style="text-align:center;">
            <td>@d.ClienteNombre</td>
            <td>$@d.TotalDeuda</td>
            <td>$@d.TotalPagado</td>
            <td class="deuda">$@d.Debe</td>
            <td>
                <a asp-page="Pagos"
                   asp-route-clienteId="@d.ClienteId"
                   class="btn btn-primary btn-sm">
                   👁️ Ver detalles
                </a>
                <a href="@link"
                    target="_blank"
                    class="btn btn-success btn-sm">

                        <i class="bi bi-whatsapp"></i> WhatsApp

                    </a>
            </td>
        </tr>
    }
    <thead>
</table>
</div>

</div>

<hr />

<!-- 🔥 MODAL -->
<div class="modal fade show"
     id="modalDetalle"
     style="display:@(Model.ClienteIdActual != null ? "block" : "none"); background:rgba(0,0,0,0.5);">

    <div class="modal-dialog modal-xl">
        <div class="modal-content">

            <div class="modal-header">
                <h5>Detalle de @Model.ClienteNombreActual</h5>
                <a asp-page="Pagos" class="btn-close"></a>
            </div>

            <div class="modal-body">

                @if (Model.ClienteIdActual != null)
                {
                    <div class="table-responsive">

                        <table class="table table-hover align-middle">
                        <tr>
                            <th>Producto</th>
                            <th>Fecha</th>
                            <th>Total</th>
                            <th>Pagado</th>
                            <th>Debe</th>
                            <th>Acciones</th>
                        </tr>

                        @foreach (var v in Model.VentasCliente)
                        {
                            var debe = v.Total - (v.Pagado ?? 0);

                            <tr style="text-align:center;">
                                <td>@v.ProductoNombre</td>
                                <td>@v.Fecha.ToString("dd/MM/yyyy")</td>
                                <td>$@v.Total</td>
                                <td>$@v.Pagado</td>
                                <td class="deuda">$@debe</td>

                                <td>
                                    @if (debe > 0)
                                    {
                                        <div style="display:flex; justify-content:center; align-items:center; gap:5px;">

                                            <!-- 💰 ABONAR -->
                                            <form method="post" asp-page-handler="AbonarVenta" onsubmit="return validarAbono(this)">
                                                <input type="hidden" name="ventaId" value="@v.Id" />
                                                <input type="hidden" name="clienteId" value="@Model.ClienteIdActual" />
                                                <input type="number" step="0.01" name="abono" placeholder="$" style="width:70px;" />
                                                <button class="btn btn-primary btn-sm">Abonar 💰</button>
                                            </form>

                                            <!-- ✔ LIQUIDAR -->
                                            <form method="post" asp-page-handler="LiquidarVenta">
                                                <input type="hidden" name="ventaId" value="@v.Id" />
                                                <input type="hidden" name="clienteId" value="@Model.ClienteIdActual" />
                                                <button onclick="return confirm('¿Liquidar este producto?')"style="background:#198754;color:white;">Liquidar✔</button>
                                            </form>

                                        </div>
                                    }
                                    else
                                    {
                                        <!-- ↩ DESHACER -->
                                        <form method="post" asp-page-handler="DeshacerLiquidacion">
                                            <input type="hidden" name="ventaId" value="@v.Id" />
                                            <input type="hidden" name="clienteId" value="@Model.ClienteIdActual" />
                                            <button class="btn btn-success btn-sm">
                                                ↩
                                            </button>
                                        </form>
                                    }
                                </td>
                            </tr>
                        }
                    </table>
                    </div>
                }
                <script>
                function validarAbono(form) {
                    var abono = form.abono.value;

                    if (!abono || parseFloat(abono) <= 0) {
                        alert("Ingresa un monto válido");
                        return false;
                    }

                    return true;
                }
                </script>

            </div>

        </div>
    </div>
</div>