@page
@model TienditaApp.Pages.PagosModel

<h1>Pagos 💰</h1>

<style>
table {
    width: 100%;
    border-collapse: collapse;
    margin-top: 20px;
}

th, td {
    padding: 10px;
    border-bottom: 1px solid #ddd;
}

tr:hover {
    background-color: #f5f5f5;
}

button {
    padding: 6px 10px;
    border: none;
    border-radius: 5px;
    cursor: pointer;
}

input, select {
    padding: 6px;
    margin: 5px;
}
</style>

<!-- 💳 ABONO GLOBAL -->
<h2>💳 Abonar a cuenta de cliente</h2>

<form method="post" asp-page-handler="Abonar">
    <select asp-for="ClienteId">
        <option value="">-- Selecciona cliente --</option>

        @foreach (var c in Model.DeudasCliente)
        {
            <option value="@c.ClienteId">
                @c.ClienteNombre - Debe: $@c.Debe
            </option>
        }
    </select>

    <input asp-for="Abono" type="number" step="0.01" placeholder="Monto a abonar" />

    <button type="submit" style="background:green;color:white;">
        Abonar 💰
    </button>
</form>

<hr />

<!-- 📊 DEUDA TOTAL POR CLIENTE -->
<h2>Deuda por cliente 👤</h2>

<table>
    <tr style="background:#198754;color:white;">
        <th>Cliente</th>
        <th>Total deuda</th>
        <th>Total pagado</th>
        <th>Debe</th>
    </tr>

@foreach (var c in Model.DeudasCliente)
{
    <tr>
        <td>@c.ClienteNombre</td>
        <td>$@c.TotalDeuda</td>
        <td>$@c.TotalPagado</td>
        <td style="color:red;font-weight:bold;">
            $@c.Debe
        </td>
    </tr>
}
</table>