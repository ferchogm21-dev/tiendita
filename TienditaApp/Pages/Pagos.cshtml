@page
@model TienditaApp.Pages.PagosModel

<h1>💰 Pagos / Deudores</h1>

<hr />

<h2>Clientes con deuda</h2>

<table style="width:100%; border-collapse: collapse;">
    <tr style="background:#0d6efd; color:white;">
        <th>Cliente</th>
        <th>Total</th>
        <th>Pagado</th>
        <th>Debe</th>
        <th>Acciones</th>
    </tr>

    
    @foreach (var d in Model.DeudasCliente)
    {
        <tr style="text-align:center;">
        
            <td>@d.ClienteNombre</td>
            <td>$@d.TotalDeuda</td>
            <td>$@d.TotalPagado</td>
            <td style="color:red;">$@d.Debe</td>
            <td>
                <a href="/Pagos?clienteId=@d.ClienteId">Ver detalle</a>
            </td>
        </tr>
    }
</table>

<hr />

@if (Model.ClienteIdActual != null)
{
    <h2>Detalle de @Model.ClienteNombreActual</h2>

    <table style="width:100%; border-collapse: collapse;">
        <tr style="background:#198754; color:white;">
            <th>Total</th>
            <th>Pagado</th>
            <th>Debe</th>
        </tr>

        @foreach (var v in Model.VentasCliente)
        {
            <tr style="text-align:center;">
                <td>$@v.Total</td>
                <td>$@v.Pagado</td>
                <td style="color:red;">$@(v.Total - v.Pagado)</td>
            </tr>
        }
    </table>

    <br />

        <form method="post">
        <input type="hidden" name="ClienteId" value="@Model.ClienteIdActual" />

        <input type="number" step="0.01" name="Abono" placeholder="Monto a abonar" />

        <!-- 💰 ABONAR -->
        <button type="submit" formaction="?handler=Abonar" style="background:#0d6efd;color:white;">
            💰 Abonar
        </button>

        <!-- 🧾 LIQUIDAR -->
        <button type="submit" formaction="?handler=LiquidarCliente" style="background:red;color:white;"
                onclick="return confirm('¿Seguro que quieres liquidar toda la deuda?')">
            🧾 Liquidar todo
        </button>
    </form>
}