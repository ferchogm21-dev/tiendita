@page
@model TienditaApp.Pages.PagosModel

<h1>💰 Pagos / Deudores</h1>

<h3>💰 Total que deben todos: $@Model.TotalGeneralDeuda</h3>
<hr />

<h2>Clientes con deuda</h2>
<style>
    input {
        padding: 8px;
        margin: 5px;
        border: 1px solid #ccc;
        border-radius: 5px;
    }
    table {
        width: 100%;
        border-collapse: collapse;
        margin-top: 20px;
    }

    th, td {
        padding: 10px;
        border-bottom: 1px solid #ddd;
    }

    tr:hover {
        background-color: #f5f5f5;
    }

    button {
        padding: 5px 10px;
        border: none;
        border-radius: 5px;
        cursor: pointer;
    }

    button:hover {
        opacity: 0.8;
    }
</style>
<table style="width:100%; border-collapse: collapse;">
    <tr style="background:#0d6efd; color:white;">
        <th>Cliente</th>
        <th>Total</th>
        <th>Pagado</th>
        <th>Debe</th>
        <th>Acciones</th>
    </tr>

    @foreach (var d in Model.DeudasCliente)
    {
        <tr style="text-align:center;">
        
            <td>@d.ClienteNombre</td>
            <td>$@d.TotalDeuda</td>
            <td>$@d.TotalPagado</td>
            <td style="color:red;">$@d.Debe</td>
            <td>
                <!-- ✅ CORREGIDO -->
                <a asp-page="Pagos"
   asp-route-clienteId="@d.ClienteId"
   class="btn btn-sm btn-info">
    <i class="bi bi-eye"></i>👁️ Ver detalles
</a>
            </td>
        </tr>
    }
</table>

<hr />

@if (Model.ClienteIdActual != null)
{
    <h2>Detalle de @Model.ClienteNombreActual</h2>

    <table style="width:100%; border-collapse: collapse;">
        <tr style="background:#198754; color:white;">
            <th>Producto</th>
            <th>Total</th>
            <th>Pagado</th>
            <th>Debe</th>
        </tr>

        @foreach (var v in Model.VentasCliente)
        {
            <tr style="text-align:center;">
                <td>@v.ProductoNombre</td>
                <td>$@v.Total</td>
                <td>$@v.Pagado</td>
                <td style="color:red;">
                $@(v.Total > v.Pagado ? v.Total - v.Pagado : 0m)
            </td>
            </tr>
        }
    </table>

    <br />

    <!-- ✅ FORM CORREGIDO -->
    <form method="post">

        <!-- IMPORTANTE: mantener cliente -->
        <input type="hidden" name="clienteId" value="@Model.ClienteIdActual" />

        <input type="number" step="0.01" name="abono" placeholder="Monto a abonar" />

        <!-- 💰 ABONAR -->
        <button type="submit"
                formaction="/Pagos?handler=Abonar"
                style="background:#0d6efd;color:white;">
            💰 Abonar
        </button>

        

    </form>
}