@page
@model IndexModel

<h1>🏪 @Model.Negocio</h1>

<hr />

<h2>
    Bienvenido @Model.Nombre 👋
</h2>

<p>
    Rol: <strong>@Model.Rol</strong>
</p>

<div style="display:flex; gap:20px; flex-wrap:wrap;">

    <a href="/Productos"
       style="
       padding:20px;
       background:#0d6efd;
       color:white;
       text-decoration:none;">

        📦 Productos

    </a>

    <a href="/Clientes"
       style="
       padding:20px;
       background:#198754;
       color:white;
       text-decoration:none;">

        👤 Clientes

    </a>

    <a href="/Ventas"
       style="
       padding:20px;
       background:#dc3545;
       color:white;
       text-decoration:none;">

        🧾 Ventas

    </a>

    <a href="/Pagos"
       style="
       padding:20px;
       background:#ffc107;
       color:black;
       text-decoration:none;">

        💰 Pagos

    </a>

    @if (Model.Rol == "ADMIN")
    {
        <a href="/Usuarios"
           style="
           padding:20px;
           background:#6f42c1;
           color:white;
           text-decoration:none;">

            👑 Usuarios

        </a>
    }

</div>