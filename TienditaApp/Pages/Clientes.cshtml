@page
@model TienditaApp.Pages.ClientesModel

<h1>Clientes 👤</h1>

<style>
    input {
        padding: 8px;
        margin: 5px;
        border: 1px solid #ccc;
        border-radius: 5px;
    }
    table {
        width: 100%;
        border-collapse: collapse;
        margin-top: 20px;
    }

    th, td {
        padding: 10px;
        border-bottom: 1px solid #ddd;
    }

    tr:hover {
        background-color: #f5f5f5;
    }

    button {
        padding: 5px 10px;
        border: none;
        border-radius: 5px;
        cursor: pointer;
    }

    button:hover {
        opacity: 0.8;
    }
</style>
<div asp-validation-summary="All" style="color:red; margin-bottom:10px;"></div>
<!-- FORMULARIO -->
<form method="post">

    <input type="hidden" asp-for="Cliente.Id" />

    <div>
        <label>Nombre Cliente:</label><br />
        <input asp-for="Cliente.Nombre" placeholder="Nombre" />
        <span asp-validation-for="Cliente.Nombre" style="color:red"></span>
    </div>
    <div>
        <label>Télefono:</label><br />
        <input asp-for="Cliente.Telefono" placeholder="Télefono" />
    </div>

    <button type="submit">
        @(Model.Cliente.Id == 0 ? "Guardar" : "Actualizar")
    </button>

</form>

<hr />

<h2>Lista de clientes</h2>

<table>
    <tr style="background:#198754; color:white;">
        <th>Nombre</th>
        <th>Teléfono</th>
        <th>Acciones</th>
    </tr>
    @section Scripts {
    <partial name="_ValidationScriptsPartial" />
    }
    @if (TempData["Mensaje"] != null)
    {
        <div style="background:#d4edda; color:#155724; padding:10px; border-radius:5px; margin-bottom:10px;">
            @TempData["Mensaje"]
        </div>
    }
    @foreach (var item in Model.ListaClientes)
    {
        <tr style="text-align:center;">
            <td>@item.Nombre</td>
            <td>@item.Telefono</td>
            <td>

                <!-- ✏️ EDITAR (usa GET con id) -->
                <a asp-page="Clientes"
                asp-page-handler="Editar"
                asp-route-id="@item.Id"
                style="background:#0d6efd;color:white;padding:5px 10px;border-radius:5px;text-decoration:none;">
                ✏️ Editar
                </a>

                

            <!-- 🗑 ELIMINAR -->
            <form method="post" style="display:inline;">
                <button type="submit"
                        formaction="?handler=Eliminar&id=@item.Id"
                        style="background:red;color:white;">
                    🗑 Eliminar
                </button>
            </form>

        </td>
    </tr>
}
</table>
<nav>
    <ul class="pagination justify-content-center">

        <!-- Anterior -->
        <li class="page-item @(Model.PageNumber == 1 ? "disabled" : "")">
            <a class="page-link" href="?pageNumber=@(Model.PageNumber - 1)">
                «
            </a>
        </li>

        <!-- Números -->
        @for (int i = 1; i <= Model.TotalPages; i++)
        {
            <li class="page-item @(i == Model.PageNumber ? "active" : "")">
                <a class="page-link" href="?pageNumber=@i">@i</a>
            </li>
        }

        <!-- Siguiente -->
        <li class="page-item @(Model.PageNumber == Model.TotalPages ? "disabled" : "")">
            <a class="page-link" href="?pageNumber=@(Model.PageNumber + 1)">
                »
            </a>
        </li>

    </ul>
</nav>