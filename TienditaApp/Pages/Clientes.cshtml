@page
@model TienditaApp.Pages.ClientesModel

<h1 class="mb-4">Clientes 👤</h1>

<!-- MENSAJE -->
@if (TempData["Mensaje"] != null)
{
    <div class="alert alert-success">
        @TempData["Mensaje"]
    </div>
}

<!-- BOTON -->
<button class="btn btn-success mb-3"
        data-bs-toggle="modal"
        data-bs-target="#modalCliente">

    ➕ Agregar Cliente
</button>

<!-- MODAL -->
<div class="modal fade" id="modalCliente" tabindex="-1">

    <div class="modal-dialog modal-lg">

        <div class="modal-content">

            <!-- HEADER -->
            <div class="modal-header bg-success text-white">

                <h5 class="modal-title">
                    @(Model.Cliente.Id == 0
                        ? "Nuevo Cliente"
                        : "Editar Cliente")
                </h5>

                <button type="button"
                        class="btn-close btn-close-white"
                        data-bs-dismiss="modal">
                </button>

            </div>

            <!-- FORM -->
            <form method="post">

                <div class="modal-body">

                    <input type="hidden"
                           asp-for="Cliente.Id" />

                    <div asp-validation-summary="All"
                         class="text-danger mb-3">
                    </div>

                    <!-- NOMBRE -->
                    <div class="mb-3">

                        <label class="form-label">
                            Nombre Cliente
                        </label>

                        <input asp-for="Cliente.Nombre"
                               class="form-control"
                               placeholder="Nombre" />

                        <span asp-validation-for="Cliente.Nombre"
                              class="text-danger">
                        </span>

                    </div>

                    <!-- TELEFONO -->
                    <div class="mb-3">

                        <label class="form-label">
                            Teléfono
                        </label>

                        <input asp-for="Cliente.Telefono"
                               class="form-control"
                               placeholder="Teléfono" />

                    </div>

                </div>

                <!-- FOOTER -->
                <div class="modal-footer">

                    <button type="button"
                            class="btn btn-secondary"
                            data-bs-dismiss="modal">

                        Cancelar
                    </button>

                    <button type="submit"
                            class="btn btn-success">

                        @(Model.Cliente.Id == 0
                            ? "Guardar"
                            : "Actualizar")

                    </button>

                </div>

            </form>

        </div>

    </div>

</div>

<hr />

<h3>Lista de clientes</h3>

<div class="table-responsive">

    <table class="table table-hover table-bordered">

        <thead class="table-success">

            <tr>
                <th>Nombre</th>
                <th>Teléfono</th>
                <th style="width:220px;">Acciones</th>
            </tr>

        </thead>

        <tbody>

            @foreach (var item in Model.ListaClientes)
            {
                <tr class="text-center">

                    <td>@item.Nombre</td>

                    <td>@item.Telefono</td>

                    <td>

                        <!-- EDITAR -->
                        <a asp-page="Clientes"
                           asp-page-handler="Editar"
                           asp-route-id="@item.Id"
                           class="btn btn-primary btn-sm">

                            ✏️ Editar
                        </a>

                        <!-- ELIMINAR -->
                        <form method="post"
                              style="display:inline;">

                            <button type="submit"
                                    formaction="?handler=Eliminar&id=@item.Id"
                                    class="btn btn-danger btn-sm">

                                🗑 Eliminar
                            </button>

                        </form>

                    </td>

                </tr>
            }

        </tbody>

    </table>

</div>

<!-- PAGINACION -->
<nav>

    <ul class="pagination justify-content-center">

        <!-- ANTERIOR -->
        <li class="page-item @(Model.PageNumber == 1 ? "disabled" : "")">

            <a class="page-link"
               href="?pageNumber=@(Model.PageNumber - 1)">

                «
            </a>

        </li>

        <!-- NUMEROS -->
        @for (int i = 1; i <= Model.TotalPages; i++)
        {
            <li class="page-item @(i == Model.PageNumber ? "active" : "")">

                <a class="page-link"
                   href="?pageNumber=@i">

                    @i
                </a>

            </li>
        }

        <!-- SIGUIENTE -->
        <li class="page-item @(Model.PageNumber == Model.TotalPages ? "disabled" : "")">

            <a class="page-link"
               href="?pageNumber=@(Model.PageNumber + 1)">

                »
            </a>

        </li>

    </ul>

</nav>

@section Scripts {

    <partial name="_ValidationScriptsPartial" />

}