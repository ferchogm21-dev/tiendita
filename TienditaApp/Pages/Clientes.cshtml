@page
@model TienditaApp.Pages.ClientesModel

<h1>Clientes 👤</h1>

<style>
    table {
        width: 100%;
        border-collapse: collapse;
        margin-top: 20px;
    }

    th, td {
        padding: 10px;
        border-bottom: 1px solid #ddd;
    }

    tr:hover {
        background-color: #f5f5f5;
    }

    button {
        padding: 5px 10px;
        border: none;
        border-radius: 5px;
        cursor: pointer;
    }

    button:hover {
        opacity: 0.8;
    }
</style>

<!-- FORMULARIO -->
<form method="post">
    <input asp-for="Cliente.Id" type="hidden" />

    <input asp-for="Cliente.Nombre" placeholder="Nombre del cliente" />
    <input asp-for="Cliente.Telefono" placeholder="Teléfono" />

    <button type="submit">
        @(Model.Cliente != null && Model.Cliente.Id > 0 ? "Actualizar" : "Guardar")
    </button>
</form>

<hr />

<h2>Lista de clientes</h2>

<table>
    <tr style="background:#198754; color:white;">
        <th>Nombre</th>
        <th>Teléfono</th>
        <th>Acciones</th>
    </tr>

@foreach (var item in Model.Lista)
{
    <tr style="text-align:center;">
        <td>@item.Nombre</td>
        <td>@item.Telefono</td>
        <td>

            <!-- ✏️ EDITAR (usa GET con id) -->
            <a asp-page="./Clientes"
   asp-route-id="@item.Id"
   style="background:#0d6efd;color:white;padding:5px 10px;border-radius:5px;text-decoration:none;">
   ✏️ Editar
</a>

            <!-- 🗑 ELIMINAR -->
            <form method="post" style="display:inline;">
                <button type="submit"
                        formaction="?handler=Eliminar&id=@item.Id"
                        style="background:red;color:white;">
                    Eliminar
                </button>
            </form>

        </td>
    </tr>
}
</table>