<!DOCTYPE html>
<html lang="en">

   <style>

.dropdown-item:hover {
    background: #f8f9fa;
}

</style> 
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - TienditaApp</title>

    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/TienditaApp.styles.css" asp-append-version="true" />
</head>
<body>

    @{
    var usuario = Context.Session.GetString("Usuario") ?? "Invitado";
    var esLogin = Context.Request.Path.StartsWithSegments("/Login");
    }
    @* 🔥 HEADER SOLO SI NO ES LOGIN *@
    @if (!esLogin)
    {
        <header>

    <nav class="navbar navbar-expand-lg navbar-dark bg-primary shadow">

        <div class="container-fluid">

            <!-- LOGO -->
            <a class="navbar-brand fw-bold"
               href="/Index">

                🏪 @Context.Session.GetString("Negocio")

            </a>

            <!-- BOTON MOVIL -->
            <button class="navbar-toggler"
                    type="button"
                    data-bs-toggle="collapse"
                    data-bs-target="#menuNavbar">

                <span class="navbar-toggler-icon"></span>

            </button>

            <!-- CONTENIDO -->
            <div class="collapse navbar-collapse"
                 id="menuNavbar">

                <!-- LINKS -->
                <ul class="navbar-nav me-auto mb-2 mb-lg-0">

                    <li class="nav-item">
                        <a class="nav-link" href="/Index">
                            Inicio
                        </a>
                    </li>

                    <li class="nav-item">
                        <a class="nav-link" href="/Productos">
                            Productos
                        </a>
                    </li>

                    <li class="nav-item">
                        <a class="nav-link" href="/Clientes">
                            Clientes
                        </a>
                    </li>

                    <li class="nav-item">
                        <a class="nav-link" href="/Ventas">
                            Ventas
                        </a>
                    </li>

                    <li class="nav-item">
                        <a class="nav-link" href="/Pagos">
                            Pagos
                        </a>
                    </li>

                </ul>

                <!-- DROPDOWN USUARIO -->
                <div class="dropdown mt-3 mt-lg-0">

                    <button class="btn btn-outline-light dropdown-toggle"
                            type="button"
                            data-bs-toggle="dropdown">

                        👤 @usuario

                    </button>

                    <ul class="dropdown-menu dropdown-menu-lg-end">

                        <li>

                            <form method="post"
                                asp-page="/Login"
                                asp-page-handler="Logout"
                                class="m-0 p-0">

                                <button type="submit"
                                        class="dropdown-item w-100">

                                    🔒 Cerrar sesión

                                </button>

                            </form>

                        </li>

                    </ul>

                </div>

            </div>

        </div>

    </nav>

</header>
    }

    <div class="container">
        <main role="main" class="pb-3">
            @RenderBody()
        </main>
    </div>

    @* 🔥 FOOTER SOLO SI NO ES LOGIN *@
    @if (!esLogin)
    {
        <footer class="border-top footer text-muted">
            <div class="container">
                &copy; 2026 - TienditaApp
            </div>
        </footer>
    }

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>

    @await RenderSectionAsync("Scripts", required: false)

<script>
    function toggleMenu() {
        const menu = document.getElementById("menuUsuario");
        menu.style.display = menu.style.display === "block" ? "none" : "block";
    }

    // cerrar si haces clic fuera
    window.onclick = function(e) {
        if (!e.target.closest('#menuUsuario') && !e.target.closest('button')) {
            const menu = document.getElementById("menuUsuario");
            if (menu) menu.style.display = "none";
        }
    }
</script>

</body>
</html>