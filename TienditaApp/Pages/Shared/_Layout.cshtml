<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - TienditaApp</title>
    <script type="importmap"></script>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/TienditaApp.styles.css" asp-append-version="true" />
</head>
<body>
    <header>
      <nav style="background:#0d6efd; padding:15px; display:flex; gap:20px; align-items:center;">

    <span style="color:white; font-weight:bold;">
        🏪 Mi Tiendita
    </span>

    <a href="/" style="color:white; text-decoration:none;">Inicio</a>
    <a href="/Productos" style="color:white; text-decoration:none;">Productos</a>
    <a href="/Clientes" style="color:white; text-decoration:none;">Clientes</a>
    <a href="/Ventas" style="color:white; text-decoration:none;">Ventas</a>
    <a href="/Pagos" style="color:white; text-decoration:none;">Pagos</a>

</nav>
    </header>
    <div class="container">
        <main role="main" class="pb-3">
            @RenderBody()
        </main>
    </div>

    <footer class="border-top footer text-muted">
        <div class="container">
            &copy; 2026 - TienditaApp - <a asp-area="" asp-page="/Privacy">Privacy</a>
        </div>
    </footer>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>

    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
