@page
@model LoginModel
@{
    Layout = null;
}

<!DOCTYPE html>
<html>
<head>
    <meta charset="utf-8" />

    <title>Login - Mi Tiendita</title>

    <link rel="stylesheet" href="~/css/login.css" />
</head>

<body class="login-body">

    <div class="login-container">

        <div class="login-card">

            <!-- LOGO -->
            <img src="~/images/logo-ferxxito1.png" class="logo" />

            <h2>Iniciar sesión</h2>

            <p class="subtitle">
                Bienvenido de vuelta
            </p>

            <form method="post">

                <input type="text"
                       name="Usuario"
                       placeholder="Ingresa tu usuario"
                       class="input" />

                <input type="password"
                       name="Password"
                       placeholder="Ingresa tu contraseña"
                       class="input" />

                <div class="options">

                    <label>
                        <input type="checkbox" />
                        Recordarme
                    </label>

                </div>

                <button type="submit" class="btn-login">
                    Iniciar sesión
                </button>

            </form>

            @if (!string.IsNullOrEmpty(Model.Error))
            {
                <div style="
                    color:red;
                    margin-top:15px;
                    font-weight:bold;
                    text-align:center;">
                    @Model.Error
                </div>
            }

            <p class="footer">
                Sistema de Tiendita
            </p>

        </div>

    </div>

</body>
</html>