@page
@model LoginModel
@{
    Layout = null;
}

<!DOCTYPE html>
<html>
<head>
    <meta charset="utf-8" />
    <title>Login - Ferxxito</title>
    <link rel="stylesheet" href="~/css/login.css" />
</head>

<body class="login-body">

    <div class="login-container">

        <div class="login-card">

            <!-- LOGO -->
            <img src="~/images/logo-ferxxito.png" class="logo" />

            <h2>Iniciar sesión</h2>
            <p class="subtitle">Bienvenido de vuelta a Ferxxito</p>

            <form method="post">

                <input type="text" name="Usuario" placeholder="Ingresa tu usuario" class="input" />

                <input type="password" name="Password" placeholder="Ingresa tu contraseña" class="input" />

                <div class="options">
                    <label><input type="checkbox" /> Recordarme</label>
                    
                </div>

                <button type="submit" class="btn-login">
                    Iniciar sesión
                </button>

            </form>

            <p class="footer">Ferxxito — Tu tiendita de confianza</p>

        </div>

    </div>

</body>
</html>