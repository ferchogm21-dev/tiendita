@page "{handler?}/{id?}"
@model TienditaApp.Pages.ProductosModel

<style>
    input {
        padding: 8px;
        margin: 5px;
        border: 1px solid #ccc;
        border-radius: 5px;
    }

    button {
        padding: 6px 12px;
        border: none;
        border-radius: 5px;
        cursor: pointer;
    }

    button:hover {
        opacity: 0.8;
    }

    table {
        width: 100%;
        border-collapse: collapse;
        margin-top: 20px;
    }

    th, td {
        padding: 10px;
        border-bottom: 1px solid #ddd;
    }

    tr:hover {
        background-color: #f5f5f5;
    }
</style>

<h1>Productos 📦</h1>

<h2>@(Model.Producto.Id == 0 ? "Nuevo Producto" : "Editando Producto")</h2>

<form method="post">

    <!-- ID -->
    <input type="hidden" name="Producto.Id" value="@(Model.Producto?.Id ?? 0)" />

    <input name="Producto.Nombre" value="@(Model.Producto?.Nombre ?? "")" placeholder="Nombre" />
    <input name="Producto.Precio" value="@(Model.Producto?.Precio ?? 0)" placeholder="Precio" />
    <input name="Producto.Stock" value="@(Model.Producto?.Stock ?? 0)" placeholder="Stock" />

    <button type="submit">
        @(Model.Producto.Id == 0 ? "Guardar" : "Actualizar")
    </button>
</form>

<hr />

<table>
    <tr style="background:#0d6efd; color:white;">
        <th>Nombre</th>
        <th>Precio</th>
        <th>Stock</th>
        <th>Acciones</th>
    </tr>

    @foreach (var p in Model.Lista)
    {
        <tr style="text-align:center;">
            <td>@p.Nombre</td>
            <td>$@p.Precio</td>
            <td>@p.Stock</td>
            <td>

                <!-- ✏️ EDITAR (MISMO ESTILO PERO GET) -->
                <form method="get" style="display:inline;">
    <button type="submit"
            formaction="/Productos/Editar/@p.Id"
            style="background:#0d6efd;color:white; padding:5px 10px; border-radius:5px;">
        ✏️ Editar
    </button>
</form>

                <!-- 🗑 ELIMINAR -->
                <form method="post" style="display:inline;">
                    <button type="submit"
                            formaction="/Productos?handler=Eliminar&id=@p.Id"
                            style="background:red;color:white; padding:5px 10px; border-radius:5px;">
                        🗑 Eliminar
                    </button>
                </form>

            </td>
        </tr>
    }
</table>