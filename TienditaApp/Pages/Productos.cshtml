@page
@model TienditaApp.Pages.ProductosModel

<style>
    input {
        padding: 8px;
        margin: 5px;
        border: 1px solid #ccc;
        border-radius: 5px;
    }

    button {
        padding: 6px 12px;
        border: none;
        border-radius: 5px;
        cursor: pointer;
    }

    button:hover {
        opacity: 0.8;
    }

    table {
        width: 100%;
        border-collapse: collapse;
        margin-top: 20px;
    }

    th, td {
        padding: 10px;
        border-bottom: 1px solid #ddd;
    }

    tr:hover {
        background-color: #f5f5f5;
    }
</style>

<h1>Productos 📦</h1>

<h2>@(Model.Producto.Id == 0 ? "Nuevo Producto" : "Editando Producto")</h2>
<div asp-validation-summary="All" style="color:red; margin-bottom:10px;"></div>

<form method="post">

    <input type="hidden" asp-for="Producto.Id" />

    <div>
        <label>Nombre Producto:</label><br />
        <input asp-for="Producto.Nombre" placeholder="Nombre" />
        <span asp-validation-for="Producto.Nombre" style="color:red"></span>
    </div>

    <div>
        <label>Precio Producto:</label><br />
        <input asp-for="Producto.Precio" placeholder="Precio" />
        <span asp-validation-for="Producto.Precio" style="color:red"></span>
    </div>

    <div>
        <label>Stock:</label><br />
        <input asp-for="Producto.Stock" placeholder="Stock" />
        <span asp-validation-for="Producto.Stock" style="color:red"></span>
    </div>

    <button type="submit">
        @(Model.Producto.Id == 0 ? "Guardar" : "Actualizar")
    </button>
</form>

<hr />

<table>
    <tr style="background:#0d6efd; color:white;">
        <th>Nombre</th>
        <th>Precio</th>
        <th>Stock</th>
        <th>Acciones</th>
    </tr>
    @section Scripts {
    <partial name="_ValidationScriptsPartial" />
    }
    @if (TempData["Mensaje"] != null)
{
    <div style="background:#d4edda; color:#155724; padding:10px; border-radius:5px; margin-bottom:10px;">
        @TempData["Mensaje"]
    </div>
}
    @foreach (var item in Model.ListaProductos)
    {
        <tr style="text-align:center;">
            <td>@item.Nombre</td>
            <td>$@item.Precio</td>
            <td>@item.Stock</td>
            <td>

                <!-- ✏️ EDITAR (MISMO ESTILO PERO GET) -->
                <a asp-page="Productos"
                asp-page-handler="Editar"
                asp-route-id="@item.Id"
                style="background:#0d6efd;color:white; padding:5px 10px; border-radius:5px; text-decoration:none;">
                    ✏️ Editar
                </a>

                <!-- 🗑 ELIMINAR -->
                <form method="post" style="display:inline;">
                    <button type="submit"
                            formaction="/Productos?handler=Eliminar&id=@item.Id"
                            style="background:red;color:white; padding:5px 10px; border-radius:5px;">
                        🗑 Eliminar
                    </button>
                </form>

            </td>
        </tr>
    }
</table>
<nav>
    <ul class="pagination justify-content-center">

        <!-- Anterior -->
        <li class="page-item @(Model.PageNumber == 1 ? "disabled" : "")">
            <a class="page-link" href="?pageNumber=@(Model.PageNumber - 1)">
                «
            </a>
        </li>

        <!-- Números -->
        @for (int i = 1; i <= Model.TotalPages; i++)
        {
            <li class="page-item @(i == Model.PageNumber ? "active" : "")">
                <a class="page-link" href="?pageNumber=@i">@i</a>
            </li>
        }

        <!-- Siguiente -->
        <li class="page-item @(Model.PageNumber == Model.TotalPages ? "disabled" : "")">
            <a class="page-link" href="?pageNumber=@(Model.PageNumber + 1)">
                »
            </a>
        </li>

    </ul>
</nav>