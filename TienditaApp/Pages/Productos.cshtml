@page
@model TienditaApp.Pages.ProductosModel

<style>

    body {
        background: #f4f6f9;
    }

    h1 {
        font-weight: bold;
        margin-bottom: 20px;
        color: #333;
    }

    /* CARD TABLA */
    .table-container {

        background: white;

        border-radius: 18px;

        padding: 20px;

        box-shadow: 0 4px 15px rgba(0,0,0,0.08);

        margin-top: 20px;
    }

    /* TABLA */
    table {

        width: 100%;

        border-collapse: collapse;

        overflow: hidden;

        border-radius: 15px;
    }

    thead {

        background: linear-gradient(
            135deg,
            #0d6efd,
            #0b5ed7
        );

        color: white;
    }

    th {

        padding: 15px;

        text-align: center;

        font-size: 15px;

        letter-spacing: .5px;
    }

    td {

        padding: 14px;

        text-align: center;

        vertical-align: middle;

        border-bottom: 1px solid #eee;
    }

    tbody tr {

        transition: all .2s ease;
    }

    tbody tr:hover {

        background: #f8fbff;

        transform: scale(1.003);
    }

    /* BOTONES */
    .btn-custom {

        border: none;

        padding: 8px 14px;

        border-radius: 10px;

        font-weight: 600;

        transition: .2s;

        text-decoration: none;

        display: inline-flex;

        align-items: center;

        gap: 5px;
    }

    .btn-edit {

        background: #0d6efd;

        color: white;
    }

    .btn-edit:hover {

        background: #0b5ed7;

        color: white;

        transform: translateY(-2px);
    }

    .btn-delete {

        background: #dc3545;

        color: white;
    }

    .btn-delete:hover {

        background: #bb2d3b;

        transform: translateY(-2px);
    }

    .btn-add {

        background: linear-gradient(
            135deg,
            #198754,
            #157347
        );

        border: none;

        padding: 12px 18px;

        border-radius: 12px;

        font-weight: bold;

        box-shadow: 0 4px 12px rgba(25,135,84,0.3);

        transition: .2s;
    }

    .btn-add:hover {

        transform: translateY(-2px);

        opacity: .95;
    }

    /* STOCK */
    .stock-bajo {

        color: #dc3545;

        font-weight: bold;
    }

    .stock-ok {

        color: #198754;

        font-weight: bold;
    }

    /* PAGINACION */
    .pagination .page-link {

        border-radius: 10px;

        margin: 0 3px;

        border: none;

        color: #0d6efd;

        font-weight: 600;
    }

    .pagination .active .page-link {

        background: #0d6efd;

        color: white;
    }

    /* MODAL */
    .modal-content {

        border-radius: 18px;

        border: none;

        overflow: hidden;
    }

    .modal-header {

        border-bottom: none;
    }

    .modal-footer {

        border-top: none;
    }

</style>

<h1>Productos 📦</h1>

<button class="btn btn-add text-white mb-3"
        data-bs-toggle="modal"
        data-bs-target="#modalProducto">

    ➕ Agregar Producto
</button>

<div asp-validation-summary="All" style="color:red; margin-bottom:10px;"></div>

<div class="modal fade" id="modalProducto" tabindex="-1">
    <div class="modal-dialog modal-lg">
        <div class="modal-content">

            <!-- HEADER -->
            <div class="modal-header bg-primary text-white">
                <h5 class="modal-title">
                    @(Model.Producto.Id == 0 ? "Nuevo Producto" : "Editar Producto")
                </h5>

                <button type="button"
                        class="btn-close btn-close-white"
                        data-bs-dismiss="modal">
                </button>
            </div>

            <!-- FORM -->
            <form method="post">

                <div class="modal-body">

                    <input type="hidden" asp-for="Producto.Id" />

                    <div asp-validation-summary="All"
                         style="color:red; margin-bottom:10px;">
                    </div>

                    <div class="mb-3">
                        <label class="form-label">
                            Nombre Producto
                        </label>

                        <input asp-for="Producto.Nombre"
                               class="form-control"
                               placeholder="Nombre" />

                        <span asp-validation-for="Producto.Nombre"
                              class="text-danger">
                        </span>
                    </div>

                    <div class="mb-3">
                        <label class="form-label">
                            Precio
                        </label>

                        <input asp-for="Producto.Precio"
                               class="form-control"
                               placeholder="Precio" />

                        <span asp-validation-for="Producto.Precio"
                              class="text-danger">
                        </span>
                    </div>

                    <div class="mb-3">
                        <label class="form-label">
                            Stock
                        </label>

                        <input asp-for="Producto.Stock"
                               class="form-control"
                               placeholder="Stock" />

                        <span asp-validation-for="Producto.Stock"
                              class="text-danger">
                        </span>
                    </div>

                </div>

                <!-- FOOTER -->
                <div class="modal-footer">

                    <button type="button"
                            class="btn btn-secondary"
                            data-bs-dismiss="modal">

                        Cancelar
                    </button>

                    <button type="submit"
                            class="btn btn-success">

                        @(Model.Producto.Id == 0 ? "Guardar" : "Actualizar")
                    </button>

                </div>

            </form>

        </div>
    </div>
</div>

<div class="table-responsive">
<table class="table table-hover table-bordered">
    <tr style="background:#0d6efd; color:white;">
        <th>Nombre</th>
        <th>Precio</th>
        <th>Stock</th>
        <th>Acciones</th>
    </tr>
    @section Scripts {
    <partial name="_ValidationScriptsPartial" />
    }
    @if (TempData["MensajeProducto"] != null)
{
    <div style="background:#d4edda; color:#155724; padding:10px; border-radius:5px; margin-bottom:10px;">
        @TempData["MensajeProducto"]
    </div>
}
    @foreach (var item in Model.ListaProductos)
    {
        <tr style="text-align:center;">
            <td>@item.Nombre</td>
            <td>$@item.Precio</td>
            <td>@item.Stock</td>
            <td>

                <div class="d-flex justify-content-center gap-2">

                    <!-- ✏️ EDITAR -->
                    <a asp-page="Productos"
                    asp-page-handler="Editar"
                    asp-route-id="@item.Id"
                    class="btn btn-primary btn-sm">

                        ✏️ Editar

                    </a>

                    <!-- 🗑 ELIMINAR -->
                    <form method="post"
                        asp-page-handler="Eliminar"
                        onsubmit="return confirm('¿Seguro que deseas eliminar a @item.Nombre?')"
                        style="margin:0;">

                        <input type="hidden"
                            name="id"
                            value="@item.Id" />

                        <button type="submit"
                                class="btn btn-danger btn-sm">

                            🗑️ Eliminar

                        </button>

                    </form>

                </div>

            </td>
        </tr>
    }
</table>
</div>
<nav>
    <ul class="pagination justify-content-center">

        <!-- Anterior -->
        <li class="page-item @(Model.PageNumber == 1 ? "disabled" : "")">
            <a class="page-link" href="?pageNumber=@(Model.PageNumber - 1)">
                «
            </a>
        </li>

        <!-- Números -->
        @for (int i = 1; i <= Model.TotalPages; i++)
        {
            <li class="page-item @(i == Model.PageNumber ? "active" : "")">
                <a class="page-link" href="?pageNumber=@i">@i</a>
            </li>
        }

        <!-- Siguiente -->
        <li class="page-item @(Model.PageNumber == Model.TotalPages ? "disabled" : "")">
            <a class="page-link" href="?pageNumber=@(Model.PageNumber + 1)">
                »
            </a>
        </li>

    </ul>
</nav>