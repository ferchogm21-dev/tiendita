@page
@model VentasModel

<style>

/* TIPO DE VENTA */
.tipo-venta {
    display: flex;
    gap: 15px;
    margin-top: 10px;
}

.tipo-venta label {

    flex: 1;

    text-align: center;

    padding: 14px;

    border-radius: 12px;

    border: 2px solid #ddd;

    cursor: pointer;

    transition: 0.3s;

    font-weight: bold;

    user-select: none;
}

/* OCULTAR RADIO */
.tipo-venta input {
    display: none;
}

/* CONTADO ACTIVO */
.tipo-venta label:first-child:has(input:checked) {

    background: #198754;

    color: white;

    border-color: #198754;

    box-shadow: 0 0 10px rgba(25,135,84,0.4);
}

/* FIADO ACTIVO */
.tipo-venta label:last-child:has(input:checked) {

    background: #ffc107;

    color: black;

    border-color: #ffc107;

    box-shadow: 0 0 10px rgba(255,193,7,0.4);
}

/* HOVER */
.tipo-venta label:hover {
    transform: scale(1.02);
}

</style>

<h1 class="mb-4">🧾 Ventas</h1>
@if (TempData["MensajeVenta"] != null)
{
    <div class="alert alert-success alert-dismissible fade show">

        @TempData["MensajeVenta"]

        <button type="button"
                class="btn-close"
                data-bs-dismiss="alert">
        </button>

    </div>
}

<!-- CARD -->
<div class="card shadow-lg border-0 mb-4">

    <div class="card-body">

        <form method="post"
              id="formVenta"
              onsubmit="return validarVenta()">

            <!-- 🔥 ID OCULTO -->
            <input type="hidden"
                   asp-for="Venta.Id"
                   id="Venta_Id" />

            <div class="row g-3">

                <!-- PRODUCTO -->
                <div class="col-md-4">

                    <label class="form-label fw-bold">
                        Producto
                    </label>

                    <select id="productoSelect"
                            name="Venta.ProductoId"
                            class="form-select">

                        <option value="">
                            Selecciona producto
                        </option>

                        @foreach (var p in Model.Productos)
                        {
                            <option value="@p.Id"
                                    data-precio="@p.Precio"
                                    data-stock="@p.Stock">

                                @p.Nombre

                            </option>
                        }

                    </select>

                </div>

                <!-- CLIENTE -->
                <div class="col-md-4">

                    <label class="form-label fw-bold">
                        Cliente
                    </label>

                    <select id="clienteSelect"
                            name="Venta.ClienteId"
                            class="form-select">

                        <option value="">
                            Selecciona cliente
                        </option>

                        @foreach (var c in Model.Clientes)
                        {
                            <option value="@c.Id">
                                @c.Nombre
                            </option>
                        }

                    </select>

                </div>

                <!-- CANTIDAD -->
                <div class="col-md-4">

                    <label class="form-label fw-bold">
                        Cantidad
                    </label>

                    <input type="number"
                           id="cantidad"
                           name="Venta.Cantidad"
                           class="form-control"
                           placeholder="Cantidad" />

                </div>

            </div>

            <!-- TIPO -->
            <div class="mt-4">

                <label class="form-label fw-bold">
                    Tipo de venta
                </label>

                <!-- 🔥 TIPO DE VENTA -->
                <div class="mt-4">

                    <div class="tipo-venta">

                        <!-- CONTADO -->
                        <label>

                            <input type="radio"
                                   id="contadoRadio"
                                   name="Venta.EsFiado"
                                   value="false"
                                   checked />

                            💵 Contado

                        </label>

                        <!-- FIADO -->
                        <label>

                            <input type="radio"
                                   id="fiadoRadio"
                                   name="Venta.EsFiado"
                                   value="true" />

                            🧾 Fiado

                        </label>

                    </div>

                </div>

            </div>

            <!-- INFO -->
            <div class="alert alert-light border mt-4">

                <div class="row text-center">

                    <div class="col-md-4">
                        <strong>Precio:</strong>
                        $<span id="precio">0</span>
                    </div>

                    <div class="col-md-4">
                        <strong>Stock:</strong>
                        <span id="stock">0</span>
                    </div>

                    <div class="col-md-4">
                        <strong>Total:</strong>
                        $<span id="total">0</span>
                    </div>

                </div>

            </div>

            <!-- BOTON -->
            <div class="text-end mt-3">

                <button type="submit"
                        id="btnVender"
                        class="btn btn-success btn-lg">

                    💰 Vender

                </button>

            </div>

        </form>

    </div>

</div>

<!-- HISTORIAL -->
<div class="card shadow border-0">

    <div class="card-body">

        <h3 class="mb-3">📊 Historial</h3>

        <div class="table-responsive">

            <table class="table table-hover align-middle">

                <thead class="table-danger">

                    <tr>
                        <th>Producto</th>
                        <th>Cliente</th>
                        <th>Cantidad</th>
                        <th>Tipo</th>
                        <th>Fecha</th>
                        <th>Total</th>
                        <th>Acciones</th>
                    </tr>

                </thead>

                <tbody>

                    @foreach (var v in Model.ListaVentas)
                    {
                        <tr>

                            <td>@v.Producto</td>

                            <td>@v.Cliente</td>

                            <td>@v.Cantidad</td>

                            <td>

                                @if (v.EsFiado)
                                {
                                    <span class="badge bg-warning text-dark p-2">
                                        🧾 Fiado
                                    </span>
                                }
                                else
                                {
                                    <span class="badge bg-success p-2">
                                        💵 Contado
                                    </span>
                                }

                            </td>

                            <td>
                                @v.Fecha.ToString("dd/MM/yyyy HH:mm")
                            </td>

                            <td class="fw-bold">
                                $@v.Total
                            </td>

                            <!-- 🔥 EDITAR -->
                            <td>

                                <button type="button"
                                        class="btn btn-warning btn-sm"
                                        onclick="editarVenta(
                                            @v.Id,
                                            @v.ProductoId,
                                            @v.ClienteId,
                                            @v.Cantidad,
                                            '@v.EsFiado'
                                        )">

                                    ✏️ Editar

                                </button>

                            </td>

                        </tr>
                    }

                </tbody>

            </table>

        </div>

    </div>

</div>

<!-- PAGINACION -->
<nav class="mt-4">

    <ul class="pagination justify-content-center">

        <!-- ANTERIOR -->
        <li class="page-item @(Model.PageNumber == 1 ? "disabled" : "")">

            <a class="page-link"
               href="?pageNumber=@(Model.PageNumber - 1)">

                «
            </a>

        </li>

        <!-- PAGINAS -->
        @{
            int start = Math.Max(1, Model.PageNumber - 2);
            int end = Math.Min(Model.TotalPages, Model.PageNumber + 2);
        }

        @for (int i = start; i <= end; i++)
        {
            <li class="page-item @(i == Model.PageNumber ? "active" : "")">

                <a class="page-link"
                   href="?pageNumber=@i">

                    @i
                </a>

            </li>
        }

        <!-- SIGUIENTE -->
        <li class="page-item @(Model.PageNumber == Model.TotalPages ? "disabled" : "")">

            <a class="page-link"
               href="?pageNumber=@(Model.PageNumber + 1)">

                »
            </a>

        </li>

    </ul>

</nav>

<script>

const productoSelect = document.getElementById("productoSelect");
const cantidadInput = document.getElementById("cantidad");

const precioSpan = document.getElementById("precio");
const stockSpan = document.getElementById("stock");
const totalSpan = document.getElementById("total");

const boton = document.getElementById("btnVender");

function actualizarInfo() {

    const selected =
        productoSelect.options[productoSelect.selectedIndex];

    if (!selected || !selected.value) {

        precioSpan.textContent = 0;
        stockSpan.textContent = 0;
        totalSpan.textContent = 0;

        boton.disabled = true;

        return;
    }

    const precio =
        parseFloat(selected.getAttribute("data-precio")) || 0;

    const stock =
        parseInt(selected.getAttribute("data-stock")) || 0;

    const cantidad =
        parseInt(cantidadInput.value) || 0;

    precioSpan.textContent = precio;
    stockSpan.textContent = stock;
    totalSpan.textContent = precio * cantidad;

    if (stock <= 5) {

        stockSpan.className = "text-danger fw-bold";

    } else {

        stockSpan.className = "text-success fw-bold";
    }

    if (stock === 0 || cantidad > stock || cantidad <= 0) {

        boton.disabled = true;

    } else {

        boton.disabled = false;
    }
}

function validarVenta() {

    const selected =
        productoSelect.options[productoSelect.selectedIndex];

    const clienteSelect =
        document.getElementById("clienteSelect");

    const selectedCliente =
        clienteSelect.options[clienteSelect.selectedIndex];

    if (!selected || !selected.value) {

        alert("❌ Selecciona un producto");
        return false;
    }

    if (!selectedCliente || !selectedCliente.value) {

        alert("❌ Selecciona un cliente");
        return false;
    }

    const stock =
        parseInt(selected.getAttribute("data-stock")) || 0;

    const cantidad =
        parseInt(cantidadInput.value) || 0;

    if (stock === 0) {

        alert("❌ No hay stock disponible");
        return false;
    }

    if (cantidad > stock) {

        alert("⚠️ Stock insuficiente");
        return false;
    }

    return true;
}

// 🔥 EDITAR VENTA
function editarVenta(
    id,
    productoId,
    clienteId,
    cantidad,
    esFiado)
{
    document.getElementById("Venta_Id").value = id;

    productoSelect.value = productoId;

    document.getElementById("clienteSelect").value =
        clienteId;

    cantidadInput.value = cantidad;

    // 🔥 Tipo venta
    if (esFiado === 'True') {

        document.getElementById("fiadoRadio").checked = true;

    } else {

        document.getElementById("contadoRadio").checked = true;
    }

    // 🔥 Cambiar acción del form
    document.getElementById("formVenta")
        .setAttribute("action", "?handler=Editar");

    // 🔥 Cambiar botón
    boton.innerHTML = "✏️ Actualizar Venta";

    boton.classList.remove("btn-success");

    boton.classList.add("btn-warning");

    actualizarInfo();

    // 🔥 Scroll arriba
    window.scrollTo({
        top: 0,
        behavior: 'smooth'
    });
}

productoSelect.addEventListener("change", actualizarInfo);

cantidadInput.addEventListener("input", actualizarInfo);

</script>