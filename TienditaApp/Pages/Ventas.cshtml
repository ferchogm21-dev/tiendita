@page
@model TienditaApp.Pages.VentasModel

<h1>Ventas 🧾</h1>

<style>
    table { width:100%; border-collapse:collapse; margin-top:20px; }
    th, td { padding:10px; border-bottom:1px solid #ddd; text-align:center; }
    th { background:#198754; color:white; }

    select, input {
        width: 100%;
        padding: 8px;
        margin: 5px 0;
    }

    button {
        background:#198754;
        color:white;
        border:none;
        padding:10px;
        border-radius:5px;
    }

    .debe { color:red; font-weight:bold; }
    .pagado { color:green; font-weight:bold; }
</style>

<form method="post">

    <select asp-for="ClienteId">
        @foreach (var c in Model.Clientes)
        {
            <option value="@c.Id">@c.Nombre</option>
        }
    </select>

    <select asp-for="ProductoId">
        @foreach (var p in Model.Productos)
        {
            <option value="@p.Id">@p.Nombre - $@p.Precio</option>
        }
    </select>

    <input asp-for="Cantidad" type="number" placeholder="Cantidad" />

    <label>
        <input type="checkbox" asp-for="EsCredito" />
        Crédito
    </label>

    <button type="submit">Vender</button>

</form>

<hr />

<h2>Ventas</h2>

<table>
    <tr>
        <th>Cliente</th>
        <th>Producto</th>
        <th>Cantidad</th>
        <th>Total</th>
        <th>Fecha</th>
        <th>Estado</th>
    </tr>

    @foreach (var v in Model.Ventas)
    {
        <tr>
            <td>@v.ClienteNombre</td>
            <td>@v.ProductoNombre</td>
            <td>@v.Cantidad</td>
            <td>$@v.Total</td>
            <td>@v.Fecha.ToString("dd/MM/yyyy HH:mm")</td>
            <td>
                @if (v.EsCredito && v.Pagado < v.Total)
                {
                    <span class="debe">Debe</span>
                }
                else
                {
                    <span class="pagado">Pagado</span>
                }
            </td>
        </tr>
    }
</table>